# YourTube environment template
# Copy to .env.local for local/Codex/Claude runs, use ~/.hermes/.env for Hermes cron,
# or add the same names as GitHub Actions secrets/variables.
# Never commit real API keys or passwords.

# Site/runtime overrides (optional)
NEXAFEED_SITE_URL=
NEXAFEED_SITE_NAME=YourTube
NEXAFEED_TAGLINE="Watch only those valuable for you"
NEXAFEED_REPOSITORY_URL=
NEXAFEED_TIMEZONE=Asia/Dhaka
NEXAFEED_BRANCH=main
NEXAFEED_WORKERS=6
NEXAFEED_PULL_FIRST=0
NEXAFEED_REQUIRE_CLEAN=0
NEXAFEED_PUBLISH=0
NEXAFEED_DRY_RUN=0
NEXAFEED_NO_SECONDARY=0
NEXAFEED_NO_DETAILS=0

# Optional yt-dlp path override. Leave empty when yt-dlp is on PATH.
NEXAFEED_YT_DLP=

# Optional AI/LLM provider config. The current feed collector does not require an
# LLM key, but this keeps public installs provider-agnostic for future AI steps.
# Supported providers: openai, anthropic, openrouter, google, groq, mistral,
# deepseek, xai, zai, glm, ollama, custom, none.
# zai/glm default model: glm-5.2-ultra (Z.ai GLM-5.2-Ultra)
NEXAFEED_LLM_PROVIDER=none
NEXAFEED_LLM_MODEL=
NEXAFEED_LLM_BASE_URL=
NEXAFEED_LLM_API_KEY=

# Provider-specific key aliases. Configure only the provider you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434/v1

# Email report delivery. Dry-runs do not require recipients.
NEXAFEED_EMAIL_RECIPIENTS=
NEXAFEED_REPORT_DIR=
RESEND_API_KEY=
RESEND_FROM=YourTube <onboarding@resend.dev>
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_HOME_ADDRESS=
